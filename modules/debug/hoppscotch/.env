# 对照官方 Community Edition Install and build
# https://docs.hoppscotch.io/documentation/self-host/community-edition/install-and-build
# 注意: 官方要求 env 值不要用引号包裹

#-----------------------Backend Config------------------------------#
DATABASE_URL=postgresql://hoppscotch:123456@hoppscotch-db:5432/hoppscotch
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
WHITELISTED_ORIGINS=http://127.0.0.1:3300,http://127.0.0.1:3310,http://127.0.0.1:3170,http://localhost:3300,http://localhost:3310,http://localhost:3170,app://localhost_3200,app://hoppscotch

#-----------------------Frontend Config------------------------------#
VITE_BASE_URL=http://127.0.0.1:3300
VITE_SHORTCODE_BASE_URL=http://127.0.0.1:3300
VITE_ADMIN_URL=http://127.0.0.1:3310
VITE_BACKEND_GQL_URL=http://127.0.0.1:3170/graphql
VITE_BACKEND_WS_URL=ws://127.0.0.1:3170/graphql
VITE_BACKEND_API_URL=http://127.0.0.1:3170/v1
ENABLE_SUBPATH_BASED_ACCESS=false
